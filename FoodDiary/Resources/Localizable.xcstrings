    "settings.privacy.message": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "饮食、身体记录和照片保存在这台 iPhone 的应用空间内。食迹无需账号，不上传记录，也不使用追踪或广告。用到照片时，由你在系统照片选择器中挑选。"
          }
        }
      }
    },
    "settings.privacy.sharing": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用数据不进入系统备份。你可以在「备份与数据」中通过系统分享面板导出，或清空本机记录。导出的文件含个人记录，请存放在自己信任的位置。"
          }
        }
      }
